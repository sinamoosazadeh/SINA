# APEX GEN5 PAPER configuration template — placeholders only, never real secrets.
APEX_RUNTIME_MODE=PAPER
APEX_EXCHANGE=TOOBIT
APEX_TIME_BASIS=UTC
APEX_DATA_DIR=./data
APEX_DB_PATH=./data/apex_paper.db
APEX_CODE_VERSION=5.0.0-paper
APEX_SCHEMA_VERSION=1
APEX_PARAMETER_PACKAGE=pp-default-1
# Telegram (optional for PAPER t0; system starts without these)
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_USER_IDS=
# LIVE credentials must never be set for PAPER
TOOBIT_LIVE_API_KEY=
TOOBIT_LIVE_API_SECRET=
